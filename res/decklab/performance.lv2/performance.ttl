@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<urn:decklab:threeband-performance>
    a lv2:Plugin ;
    doap:name "Deck Lab Three Band Performance" ;
    doap:maintainer [ foaf:name "Deck Lab" ] ;
    lv2:port
        [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
        [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
        [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
        [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "lever_low" ; lv2:name "Lever Low" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "lever_mid" ; lv2:name "Lever Mid" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "lever_high" ; lv2:name "Lever High" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "lever_mode" ; lv2:name "Lever Mode" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:default 0 ; lv2:portProperty lv2:integer ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "lever_amount" ; lv2:name "Lever Amount" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.65 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "isolate_low" ; lv2:name "Isolate Low" ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:default 0 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "isolate_mid" ; lv2:name "Isolate Mid" ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:default 0 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "isolate_high" ; lv2:name "Isolate High" ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:default 0 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 12 ; lv2:symbol "isolate_mode" ; lv2:name "Isolate Mode" ; lv2:minimum 0 ; lv2:maximum 5 ; lv2:default 0 ; lv2:portProperty lv2:integer ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 13 ; lv2:symbol "isolate_amount" ; lv2:name "Isolate Amount" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.65 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 14 ; lv2:symbol "bpm" ; lv2:name "BPM" ; lv2:minimum 40 ; lv2:maximum 240 ; lv2:default 120 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 15 ; lv2:symbol "beat_fraction" ; lv2:name "Beat Fraction" ; lv2:minimum 0.0625 ; lv2:maximum 1 ; lv2:default 0.5 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 16 ; lv2:symbol "release_type" ; lv2:name "Release 0 Off 1 Dry 2 Mute 3 Fade Dry" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:default 0 ; lv2:portProperty lv2:integer ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 17 ; lv2:symbol "beat_phase" ; lv2:name "Beat Phase (negative means free-run)" ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:default -1 ],
        [ a lv2:ControlPort, lv2:InputPort ; lv2:index 18 ; lv2:symbol "heartbeat" ; lv2:name "Native UI Heartbeat (0 disables)" ; lv2:minimum 0 ; lv2:maximum 65535 ; lv2:default 0 ; lv2:portProperty lv2:integer ] .
