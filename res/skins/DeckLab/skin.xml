  <ObjectName>DeckLab</ObjectName>
  <MinimumSize>800,480</MinimumSize>
  <!-- Loading screen: the Deck Lab boot screen's last frame (Plymouth leaves it on screen and the
       kiosk keeps it up until this appears), at the same position: ink, the wordmark, and the
       waveform with the playhead parked on the cue. While Mixxx loads, the waveform after the cue
       fills with deck 1's colour (the progress bar's chunk uncovers boot/loading.png).
       Both images come from Deck Lab's brand/build_assets.py; the numbers below place the progress
       bar on boot/launch.png: the bar box is the waveform's 720 px span, centred like the
       background, its contents start at the cue (margin-left 385) and on the waveform's first row
       (margin-top 98 = 2 x 241 + 96 - 480). qproperty-spacing removes the style's layout gap. -->
  <LaunchImageStyle>
    LaunchImage {
      background-color: #0d0f12;
      background-image: url(skin:boot/launch.png);
      background-repeat: no-repeat;
      background-position: center;
      qproperty-spacing: 0;
    }
    QLabel {
      image: none;
      padding: 0;
      margin: 0;
      border: none;
      min-width: 0;
      max-width: 0;
      min-height: 0;
      max-height: 0;
    }
    QProgressBar {
      background: transparent;
      border: none;
      padding: 0;
      margin: 98px 0 0 385px;
      min-width: 335px;
      max-width: 335px;
      min-height: 96px;
      max-height: 96px;
    }
    QProgressBar::chunk {
      background-color: transparent;
      background-image: url(skin:boot/loading.png);
      background-repeat: no-repeat;
      background-position: left top;
      border: none;
    }
  </LaunchImageStyle>
