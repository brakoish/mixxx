      <attribute config_key="[Master],num_samplers">16</attribute>
      <attribute config_key="[DeckLabBrowse],request">0</attribute>
      <attribute config_key="[DeckLab],four_decks">0</attribute>
      <attribute config_key="[DeckLab],browse_four">0</attribute>
      <attribute config_key="[DeckLabView],current">1</attribute>
      <attribute config_key="[DeckLabLeft],current">0</attribute>
      <attribute config_key="[DeckLabRight],current">0</attribute>
